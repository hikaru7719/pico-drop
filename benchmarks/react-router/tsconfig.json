{
	"include": ["app/**/*", ".react-router/types/**/*", "*.ts"],
	"compilerOptions": {
		"lib": ["DOM", "ES2022"],
		"types": ["node", "vite/client"],
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"jsx": "react-jsx",
		"strict": true,
		"skipLibCheck": true,
		"rootDirs": [".", ".react-router/types"]
	}
}
