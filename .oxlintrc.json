{
	"$schema": "https://unpkg.com/oxlint@1.85.0/configuration_schema.json",
	"plugins": ["eslint", "typescript", "oxc", "unicorn"],
	"categories": {
		"correctness": "error"
	},
	"rules": {
		"eslint/curly": ["error", "all"],
		"eslint/max-lines-per-function": [
			"error",
			{
				"max": 10,
				"skipBlankLines": false,
				"skipComments": false,
				"IIFEs": true
			}
		],
		"eslint/max-params": [
			"error",
			{
				"max": 4
			}
		],
		"eslint/yoda": ["error", "never"],
		"typescript/switch-exhaustiveness-check": "error"
	},
	"ignorePatterns": [
		"**/node_modules/**",
		"**/.pnpm-store/**",
		"**/.svelte-kit/**",
		"**/.wrangler/**",
		"**/dist/**",
		"**/build/**",
		"**/storybook-static/**",
		"**/coverage/**",
		"**/worker-configuration.d.ts",
		"work/**",
		"outputs/**"
	],
	"options": {
		"typeAware": true
	}
}
