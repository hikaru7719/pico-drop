{
	"$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
	"name": "pico-drop-backend",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-24",
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "pico-drop",
			"database_id": "ed6ffd17-616b-45f1-826b-47e411098c72"
		}
	],
	"triggers": {
		"crons": ["*/15 * * * *"]
	},
	"images": {
		"binding": "IMAGES"
	},
	"durable_objects": {
		"bindings": [
			{
				"name": "HUB",
				"class_name": "RoomObject"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["NearbyHub"]
		},
		{
			"tag": "v2-d1-auth",
			"deleted_classes": ["NearbyHub"],
			"new_sqlite_classes": ["RoomObject"]
		}
	]
}
